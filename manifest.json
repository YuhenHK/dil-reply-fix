{
  "manifest_version": 3,
  "name": "DIL Reply Fix",
  "version": "1.1.5",
  "description": "非官方浏览器扩展：尝试恢复 ChatGPT 中部分 GPT-6 历史回复无法正常显示的内容。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
