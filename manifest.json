{
  "manifest_version": 3,
  "name": "ChatGPT GPT-6 DIL 回复修复",
  "version": "1.1.4",
  "description": "在 ChatGPT 历史对话中的 GPT-6 DIL 回复无法显示时，使用已返回的 fallbackMarkdown 恢复正文。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
